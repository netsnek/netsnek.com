{"componentChunkName":"component---src-templates-doc-page-tsx","path":"/ja/docs/ledart/","result":{"data":{"jaenPage":{"id":"JaenPage c9d5d2a2-9fce-5d27-b857-f6011d496fd4","createdAt":"2026-08-12T08:32:43.941Z","modifiedAt":"2026-08-12T08:32:43.941Z","buildPath":"/ja/docs/ledart/","slug":"ledart","template":"JaenTemplate DocPage","excludedFromIndex":false,"jaenPageMetadata":{"title":"LEDアート","image":"https://netsnek.com/images/docs/docs.jpg","description":"Andreas と一緒に作った LED アートプロジェクトと、ソフトウェア会社が技術者から学べること。","blogPost":{"date":"2023-10-27","author":null,"category":"LEDアート"}},"pageConfig":{"label":"DocPage","childTemplates":["JaenTemplate DocPage"],"withoutJaenFrameStickyHeader":true},"jaenFields":{"IMA:MdxField":{"documentation":{"value":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"LEDアート","position":{"start":{"line":2,"column":3,"offset":3},"end":{"line":2,"column":9,"offset":9}}}],"position":{"start":{"line":2,"column":1,"offset":1},"end":{"line":2,"column":9,"offset":9}}},{"type":"paragraph","children":[{"type":"text","value":"このセクションには、私が Andreas と一緒に作った LED アートプロジェクトを集めています。","position":{"start":{"line":4,"column":1,"offset":11},"end":{"line":4,"column":51,"offset":61}}}],"position":{"start":{"line":4,"column":1,"offset":11},"end":{"line":4,"column":51,"offset":61}}},{"type":"paragraph","children":[{"type":"text","value":"Andreas は電気とレーザーの技術者で、私はソフトウェアとセキュリティの出身です。彼が何に心を注いでいたのかを見たい人へ。","position":{"start":{"line":6,"column":1,"offset":63},"end":{"line":6,"column":64,"offset":126}}},{"type":"link","title":null,"url":"https://eiergeier.at","children":[{"type":"text","value":"eiergeier.at","position":{"start":{"line":6,"column":65,"offset":127},"end":{"line":6,"column":77,"offset":139}}}],"position":{"start":{"line":6,"column":64,"offset":126},"end":{"line":6,"column":100,"offset":162}}},{"type":"text","value":" には2000年代初頭から彼のレーザーと照明技術のページがあり、自作のレーザーヘッドや DMX512 制御が並んでいます。紙の上では、これは切り離された2つの世界です。けれど工房では、それは同じ問題に対する2つの視点でした。そして私はまさにそこから計り知れないほど多くを得ました。技術者は電流と公差と材料で考え、私は状態とプロトコルとエラーケースで考えます。その2つが出会うところに、どちらか一人では思いつかなかったプロジェクトが生まれます。","position":{"start":{"line":6,"column":100,"offset":162},"end":{"line":6,"column":321,"offset":383}}}],"position":{"start":{"line":6,"column":1,"offset":63},"end":{"line":6,"column":321,"offset":383}}},{"type":"paragraph","children":[{"type":"text","value":"この協働から私が得た本当の教訓はこれです。隣接する専門分野とのパートナーシップは、ソフトウェア会社にとって付け足しではなく、新しいものが生まれる最良の源のひとつだということ。それは価値をもたらし、そしてたっぷりの楽しさをもたらします。Andreas との LED プロジェクトは、その両方でした。","position":{"start":{"line":8,"column":1,"offset":385},"end":{"line":8,"column":149,"offset":533}}}],"position":{"start":{"line":8,"column":1,"offset":385},"end":{"line":8,"column":149,"offset":533}}},{"type":"paragraph","children":[{"type":"text","value":"Andreas は2026年の初めに亡くなりました。これらのページは、彼と、共に重ねた仕事の思い出のためにあります。私たちが一緒に作り上げたものを記録し、これらのプロジェクトに宿る喜びを残しておくためのものです。","position":{"start":{"line":10,"column":1,"offset":535},"end":{"line":10,"column":107,"offset":641}}}],"position":{"start":{"line":10,"column":1,"offset":535},"end":{"line":10,"column":107,"offset":641}}},{"type":"paragraph","children":[{"type":"text","value":"個々のプロジェクトの記事は、資料の整理ができ次第掲載します。","position":{"start":{"line":12,"column":1,"offset":643},"end":{"line":12,"column":31,"offset":673}}}],"position":{"start":{"line":12,"column":1,"offset":643},"end":{"line":12,"column":31,"offset":673}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":13,"column":1,"offset":674}}},"props":{}}}},"parentPage":{"id":"JaenPage /ja/docs/","createdAt":"2026-08-12T08:32:43.898Z","modifiedAt":"2026-08-12T08:32:43.898Z","buildPath":"/ja/docs/","slug":"docs","template":null,"excludedFromIndex":null,"jaenPageMetadata":{"title":"ドキュメント","image":"https://netsnek.com/images/docs/docs.jpg","description":"私のプロジェクトと、その背後にある物語。トランザクションメールから音楽プレイヤー、Apple Silicon 上の Linux まで。","blogPost":{"date":"2026-01-05","author":null,"category":null}},"pageConfig":{"label":"Blog","icon":"FaApple","childTemplates":["JaenTe