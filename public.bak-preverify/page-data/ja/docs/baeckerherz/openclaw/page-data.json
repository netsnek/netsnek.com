":192,"offset":212}}},{"type":"text","value":" が担っていました。シフト表ボットはこの仕事を、チームがもともと書き込んでいた場所、つまり Telegram へ持っていきました。","position":{"start":{"line":4,"column":192,"offset":212},"end":{"line":4,"column":257,"offset":277}}}],"position":{"start":{"line":4,"column":1,"offset":21},"end":{"line":4,"column":257,"offset":277}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"OpenClaw とは","position":{"start":{"line":6,"column":4,"offset":282},"end":{"line":6,"column":15,"offset":293}}}],"position":{"start":{"line":6,"column":1,"offset":279},"end":{"line":6,"column":15,"offset":293}}},{"type":"paragraph","children":[{"type":"text","value":"OpenClaw は、パーソナル AI アシスタントのためのオープンソースのゲートウェイです。自前のハードウェア上でセルフホストされ、アシスタントを Telegram や WhatsApp といったメッセンジャーにつなぎます。専用ログイン付きの専用アプリの代わりに、チームはただメッセンジャーの中に、話しかけられる連絡先をひとつ持つだけです。","position":{"start":{"line":8,"column":1,"offset":295},"end":{"line":8,"column":172,"offset":466}}}],"position":{"start":{"line":8,"column":1,"offset":295},"end":{"line":8,"column":172,"offset":466}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"日常の中のボット","position":{"start":{"line":10,"column":4,"offset":471},"end":{"line":10,"column":12,"offset":479}}}],"position":{"start":{"line":10,"column":1,"offset":468},"end":{"line":10,"column":12,"offset":479}}},{"type":"paragraph","children":[{"type":"text","value":"Bäckerherz では、この土台の上で Telegram のシフト表ボットが動いていました。チームは、別のアプリをインストールしたりどこかにログインしたりすることなく、チャットの中で直接シフト表を調整し、問い合わせることができました。日々の調整にとってそれは、紙が減り、聞き返しが減り、全員が携帯で見られる一枚の計画があるということでした。","position":{"start":{"line":12,"column":1,"offset":481},"end":{"line":12,"column":173,"offset":653}}}],"position":{"start":{"line":12,"column":1,"offset":481},"end":{"line":12,"column":173,"offset":653}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"運用とスタック","position":{"start":{"line":14,"column":4,"offset":658},"end":{"line":14,"column":11,"offset":665}}}],"position":{"start":{"line":14,"column":1,"offset":655},"end":{"line":14,"column":11,"offset