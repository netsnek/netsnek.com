-18","author":null,"category":"Bäckerherz"}},"pageConfig":{"label":"DocPage","childTemplates":["JaenTemplate DocPage"],"withoutJaenFrameStickyHeader":true},"jaenFields":{"IMA:MdxField":{"documentation":{"value":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"OpenClaw シフト表ボット","position":{"start":{"line":2,"column":3,"offset":3},"end":{"line":2,"column":19,"offset":19}}}],"position":{"start":{"line":2,"column":1,"offset":1},"end":{"line":2,"column":19,"offset":19}}},{"type":"paragraph","children":[{"type":"link","title":null,"url":"/docs/baeckerherz","children":[{"type":"text","value":"Bäckerherz","position":{"start":{"line":4,"column":2,"offset":22},"end":{"line":4,"column":12,"offset":32}}}],"position":{"start":{"line":4,"column":1,"offset":21},"end":{"line":4,"column":32,"offset":52}}},{"type":"text","value":" では、ほとんどの人が起きる前に仕事の一日が始まっていました。誰がいつ焼き、ピッキングし、配達するかは、絶えず調整が必要でした。シフト表の調整は日々のオペレーション業務であり、私のパートナーである ","position":{"start":{"line":4,"column":32,"offset":52},"end":{"line":4,"column":131,"offset":151}}},{"type":"link","title":null,"url":"https://www.linkedin.com/in/momo-matsumoto-746594290/","children":[{"type":"text","value":"Momo","position":{"start":{"line":4,"column":132,"offset":152},"end":{"line":4,"column":136,"offset":156}}}],"position":{"start":{"line":4,"column":131,"offset":151},"end":{"line":4,"column":192,"offset":212}}},{"type":"text","value":" が担っていました。シフト表ボットはこの仕事を、チームがもともと書き込んでいた場所、つまり Telegram へ持っていきました。","position":{"start":{"line":4,"column":192,"offset":212},"end":{"line":4,"column":257,"offset":277}}}],"position":{"start":{"line":4,"column":1,"offset":21},"end":{"line":4,"column":257,"offset":277}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"OpenClaw とは","position":{"start":{"line":6,"column":4,"offset":282},"end":{"line":6,"column":15,"offset":293}}}],"position":{"start":{"line":6,"column":1,"offset":279},"end":{"line":6,"column":15,"offset":293}}},{"type":"paragraph","children":[{"type":"text","value":"OpenClaw は、パーソナル AI アシスタントのためのオープンソースのゲートウェイです。自前のハードウェア上でセルフホストされ、アシスタントを Telegram や WhatsApp といったメッセンジャーにつなぎます。専用ログイン付きの専用アプリの代わりに、チームはただメッセンジャーの中に、話しかけられる連絡先をひとつ持つだけです。","position":{"start":{"line":8,"column":1,"offset":295},"end":{"line":8,"column":172,"offset":466}}}],"position":{"start":{"line":8,"column":1,"offset":295},"end":{"line":8,"column":172,"offset":466}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"日常の中のボット","position":{"start":{"line":10,"column":4,"offset":471},"end":{"line":10,"column":12,"offset":479}}}],"position":{"start":{"line":10,"column":1,"offset":468},"end":{"line":10,"column":12,"offset":479}}},{"type":"paragraph","children":[{"type":"text","value":"Bäckerherz では、この土台の上で Telegram のシフト表ボットが動いていました。チームは、別のアプリをインストールしたりどこかにログインしたりすることなく、チャットの中で直接シフト表を調整し、問い合わせることができました。日々の調整にとってそれは、紙が減り、聞き返しが減り、全員が携帯で見られる一枚の計画があるということでした。","position":{"start":{"line":12,"column":1,"offset":481},"end":{"line":12,"column":173,"offset":653}}}],"position":{"start":{"line":12,"column":1,"offset":481},"end":{"line":12,"column":173,"offset":653}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"運用とスタック","position":{"start":{"line":14,"column":4,"offset":658},"end":{"line":14,"column":11,"offset":665}}}],"position":{"start":{"line":14,"column":1,"offset":655},"end":{"line":14,"column":11,"offset":665}}},{"type":"paragraph","children":[{"type":"text","value":"ゲートウェイは私のサーバーのひとつでセルフホストされていました。プロセスはローカルにのみバインドされ、外に向かって話すのはメッセンジャーへの接続だけでした。シフト表とチームのコミュニケーションはこうして、また別のサードパーティのもとではなく、自前のインフラの上にとどまりました。","position":{"start":{"line":16,"column":1,"offset":667},"end":{"line":16,"column":140,"offset":806}}}],"position":{"start":{"line":16,"column":1,"offset":667},"end":{"line":16,"column":140,"offset":806}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"ボットの周りのツーリング","position":{"start":{"line":18,"column":4,"offset":811},"end":{"line":18,"column":16,"offset":823}}}],"position":{"start":{"line"