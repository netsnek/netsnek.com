pe":"text","value":"OpenQASM には、次の 2 つの組み込み量子ゲートが用意されています。","position":{"start":{"line":7,"column":1,"offset":784},"end":{"line":7,"column":60,"offset":843}}}],"position":{"start":{"line":7,"column":1,"offset":784},"end":{"line":7,"column":60,"offset":843}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"U ゲート","position":{"start":{"line":9,"column":3,"offset":847},"end":{"line":9,"column":9,"offset":853}}}],"position":{"start":{"line":9,"column":3,"offset":847},"end":{"line":9,"column":9,"offset":853}}}],"position":{"start":{"line":9,"column":1,"offset":845},"end":{"line":9,"column":9,"offset":853}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"CX ゲート","position":{"start":{"line":10,"column":3,"offset":856},"end":{"line":10,"column":10,"offset":863}}}],"position":{"start":{"line":10,"column":3,"offset":856},"end":{"line":10,"column":10,"offset":863}}}],"position":{"start":{"line":10,"column":1,"offset":854},"end":{"line":10,"column":10,"offset":863}}}],"position":{"start":{"line":9,"column":1,"offset":845},"end":{"line":10,"column":10,"offset":863}}},{"type":"paragraph","children":[{"type":"text","value":"U ゲートは、量子ビットの状態を変化させるために使える量子ゲートです。CX ゲートは、2 つの量子ビットの状態をもつれさせるために使われる量子ゲートです。これらはどちらも基本量子ゲートです。U ゲートと CX ゲートを使えば、他のあらゆる量子ゲートを作ることができます。","position":{"start":{"line":12,"column":1,"offset":865},"end":{"line":12,"column":291,"offset":1155}}}],"position":{"start":{"line":12,"column":1,"offset":865},"end":{"line":12,"column":291,"offset":1155}}},{"type":"paragraph","children":[{"type":"text","value":"実際、OpenQASM 2 の標準ライブラリ qelib1.inc","position":{"start":{"line":14,"column":1,"offset":1157},"end":{"line":14,"column":50,"offset":1206}}},{"type":"footnoteReference","identifier":"1","label":"1","position":{"start":{"line":14,"column":50,"offset":1206},"end":{"li