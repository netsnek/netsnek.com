{"componentChunkName":"component---src-templates-doc-page-tsx","path":"/ja/docs/photonq/openqasm/gates/cnot-gate/","result":{"data":{"jaenPage":{"id":"JaenPage 2d61daf2-ee1d-5a7c-a4e7-b3e38c45ee99","createdAt":"2026-08-12T08:32:43.907Z","modifiedAt":"2026-08-12T08:32:43.907Z","buildPath":"/ja/docs/photonq/openqasm/gates/cnot-gate/","slug":"cnot-gate","template":"JaenTemplate DocPage","excludedFromIndex":false,"jaenPageMetadata":{"title":"CNOTゲート","image":"https://netsnek.com/images/docs/photonq.jpg","description":"OpenQASM チュートリアルのこの章では、量子ビットに CNOT ゲートを適用する方法について学びます。","blogPost":{"date":"2025-12-27","author":null,"category":"PhotonQ"}},"pageConfig":{"label":"DocPage","childTemplates":["JaenTemplate DocPage"],"withoutJaenFrameStickyHeader":true},"jaenFields":{"IMA:MdxField":{"documentation":{"value":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"CNOTゲート","position":{"start":{"line":1,"column":3,"offset":2},"end":{"line":1,"column":12,"offset":11}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":12,"offset":11}}},{"type":"paragraph","children":[{"type":"text","value":"量子コンピューティングは、量子重ね合わせや量子もつれといった量子力学の原理に大きく依存しています。CNOT ゲート(CX ゲートとも呼ばれます)は2つの量子ビットの状態をもつれさせるために使用でき、そのため非常に重要な量子ゲートです。OpenQASM チュートリアルのこの章では、量子ビットに CNOT ゲートを適用する方法について学びます。","position":{"start":{"line":3,"column":1,"offset":13},"end":{"line":3,"column":373,"offset":385}}}],"position":{"start":{"line":3,"column":1,"offset":13},"end":{"line":3,"column":373,"offset":385}}},{"type":"paragraph","children":[{"type":"text","value":"CNOT(または CX)は、量子コンピューティング分野における基本的な2量子ビットゲートです。OpenQASM では CNOT は組み込みゲートであり、2つの量子ビットに CNOT ゲートを適用するための構文が用意されています。","position":{"start":{"line":5,"column":1,"offset":387},"end":{"line":5,"column":195,"offset":581}}}],"position":{"start":{"line":5,"column":1,"offset":387},"end":{"line":5,"column":195,"offset":581}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"CNOTゲート","position":{"start":{"