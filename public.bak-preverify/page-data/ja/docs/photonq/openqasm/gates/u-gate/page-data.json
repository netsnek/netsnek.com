{"componentChunkName":"component---src-templates-doc-page-tsx","path":"/ja/docs/photonq/openqasm/gates/u-gate/","result":{"data":{"jaenPage":{"id":"JaenPage 11a95e80-75bc-5df1-a0ed-f810238b114d","createdAt":"2026-08-12T08:32:43.907Z","modifiedAt":"2026-08-12T08:32:43.907Z","buildPath":"/ja/docs/photonq/openqasm/gates/u-gate/","slug":"u-gate","template":"JaenTemplate DocPage","excludedFromIndex":false,"jaenPageMetadata":{"title":"Uゲート","image":"https://netsnek.com/images/docs/photonq.jpg","description":"OpenQASM チュートリアルのこの章では、量子ビットに Uゲートを適用する方法について学びます。","blogPost":{"date":"2025-12-26","author":null,"category":"PhotonQ"}},"pageConfig":{"label":"DocPage","childTemplates":["JaenTemplate DocPage"],"withoutJaenFrameStickyHeader":true},"jaenFields":{"IMA:MdxField":{"documentation":{"value":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"Uゲート","position":{"start":{"line":1,"column":3,"offset":2},"end":{"line":1,"column":9,"offset":8}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":9,"offset":8}}},{"type":"paragraph","children":[{"type":"text","value":"量子コンピューティングにおいて、Uゲートは最も重要で最も基本的な単一量子ビットの量子ゲートです。すべての単一量子ビットのユニタリ量子ゲートは、Uゲートの特別な場合とみなすことができます。OpenQASM チュートリアルのこの章では、量子ビットに Uゲートを適用する方法について学びます。","position":{"start":{"line":3,"column":1,"offset":10},"end":{"line":3,"column":294,"offset":303}}}],"position":{"start":{"line":3,"column":1,"offset":10},"end":{"line":3,"column":294,"offset":303}}},{"type":"paragraph","children":[{"type":"text","value":"OpenQASM において Uゲートは組み込みゲートであり、そのため OpenQASM は量子ビットに Uゲートを適用するための構文を提供しています。Uゲートは θ、φ、λ の 3 つのパラメータを持ちます。","position":{"start":{"line":5,"column":1,"offset":305},"end":{"line":5,"column":150,"offset":454}}}],"position":{"start":{"line":5,"column":1,"offset":305},"end":{"line":5,"column":150,"offset":454}}},{"type":"paragraph","children":[{"type":"text","value":"パラメータ θ、φ、λ を持つ Uゲートは、次の操作 RZ(φ) RY(θ) RZ(λ) と等価であるとみなすことができます。","position":{"start":{"line":7,"column":1,"offset":456},"end":{"line":7,"column":116,"offset":571}}}],"position":{"start":{"line":7,"column":1,"offset":456},"end":{"line":7,"column":116,"offset":571}}},{"type":"paragraph","children":[{"type":"text","value":"ここで、RZ(x) はブロッホ球上の Z 軸まわりの x ラジアンの回転であり、RY(x) はブロッホ球上の Y 軸まわりの x ラジアンの回転です。","position":{"start":{"line":9,"column":1,"offset":573},"end":{"line":9,"column":143,"offset":715}}}],"position":{"start":{"line":9,"column":1,"offset":573},"end":{"line":9,"column":143,"offset":715}}},{"type":"paragraph","children":[{"type":"text","value":"パラメータ θ、φ、λ を持つ Uゲートは、次の行列で表すことができます。","position":{"start":{"line":11,"column":1,"offset":717},"end":{"line":11,"column":83,"offset":799}}}],"position":{"start":{"line":11,"column":1,"offset":717},"end":{"line":11,"column":83,"offset":799}}},{"type":"mdxJsxFlowElement","name":"center","attributes":[],"children":[{"type":"math","meta":null,"value":"U(\\theta,\\phi,\\lambda) = \\begin{pmatrix}\n\\cos(\\theta/2) & -e^{-i\\lambda} \\sin(\\theta/2)\\\\\ne^{i\\phi} \\sin(\\theta/2) & e^{i(\\theta+\\delta)} \\cos(\\theta/2)\n\\end{pmatrix}","data":{"hName":"pre","hChildren":[{"type":"element","tagName":"code","properties":{"className":["language-math","math-display"]},"children":[{"type":"text","value":"U(\\theta,\\phi,\\lambda) = \\begin{pmatrix}\n\\cos(\\theta/2) & -e^{-i\\lambda} \\sin(\\theta/2)\\\\\ne^{i\\phi} \\sin(\\theta/2) & e^{i(\\theta+\\delta)} \\cos(\\theta/2)\n\\end{pmatrix}"}]}]},"position":{"start":{"line":13,"column":1,"offset":809},"end":{"line":18,"column":3,"offset":981}}}],"position":{"start":{"line":12,"column":1,"offset":800},"end":{"line":19,"column":10,"offset":991}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"text","value":"例えば、Hゲートは θ = π/2、φ = 0、λ = π のときの Uゲートの特別な場合です。","position":{"start":{"line":21,"column":1,"offset":993},"end":{"line":21,"column":90,"offset":1082}}}],"position":{"start":{"line":21,"column":1,"offset":993},"end":{"line":21,"column":90,"offset":1082}}},{"type":"paragraph","children":[{"type":"text","value":"パラメータ θ、φ、λ の値は、0(を含む)から 4π(を含まない)までの範囲を取り得ます。","position":{"start":{"line":23,"column":1,"offset":1084},"end":{"line":23,"column":84,"offset":1167}}}],"position":{"start":{"line":23,"column":1,"offset":1084},"end":{"line":23,"column":84,"offset":1167}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Uゲート","position":{"start":{"line":25,"column":4,"offset":1172},"end":{"line":25,"column":10,"offset":1178}}}],"position":{"start":{"line":25,"column":1,"offset":1169},"end":{"line":25,"column":10,"offset":1178}}},{"type":"paragraph","children":[{"type":"text","value":"Uゲートは任意の量子ビットに適用できます。","position":{"start":{"line":27,"column":1,"offset":1180},"end":{"line":27,"column":40,"offset":1219}}}],"position":{"start":{"line":27,"column":1,"offset":1180},"end":{"line":27,"column":40,"offset":1219}}},{"type":"paragraph","children":[{"type":"text","value":"量子ビット quantum_register[index] にパラメータ theta、phi、lambda を持つ Uゲートを適用するには、次の構文を使用します。","position":{"start":{"line":29,"column":1,"offset":1221},"end":{"line":29,"column":124,"offset":1344}}}],"position":{"start":{"line":29,"column":1,"offset":1221},"end":{"line":29,"column":124,"offset":1344}}},{"type":"paragraph","children":[{"type":"text","value":"U(theta, phi, lambda) quantum_register[index];\n","position":{"start":{"line":31,"column":1,"offset":1346},"end":{"line":32,"column":1,"offset":1395}}},{"type":"strong","children":[{"type":"text","value":"注意:","position":{"start":{"line":32,"column":3,"offset":1397},"end":{"line":32,"column":8,"offset":1402}}}],"position":{"start":{"line":32,"column":1,"offset":1395},"end":{"line":32,"column":10,"offset":1404}}},{"type":"text","value":" U は組み込みゲートであるため、u は予約語です。","position":{"start":{"line":32,"column":10,"offset":1404},"end":{"line":32,"column":66,"offset":1460}}}],"position":{"start":{"line":31,"column":1,"offset":1346},"end":{"line":32,"column":66,"offset":1460}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"例","position":{"start":{"line":34,"column":5,"offset":1466},"end":{"line":34,"column":12,"offset":1473}}}],"position":{"start":{"line":34,"column":1,"offset":1462},"end":{"line":34,"column":12,"offset":1473}}},{"type":"paragraph","children":[{"type":"text","value":"以下は、量子レジスタ qubits の最初の量子ビットに、パラメータ θ = π/2、φ = 0、λ = π で Uゲートを適用する例です。これらのパラメータで Uゲートを適用することは、その量子ビットに Hゲートを適用することと等価です。","position":{"start":{"line":36,"column":1,"offset":1475},"end":{"line":36,"column":214,"offset":1688}}}],"position":{"start":{"line":36,"column":1,"offset":1475},"end":{"line":36,"column":214,"offset":1688}}},{"type":"code","lang":"qasm","meta":"playground","value":"OPENQASM 2.0;\ninclude \"qelib1.inc\";\n\n// Define quantum registers\nqreg qubits[1];\n\n// Applying H gate on the first Qubit of Quantum Register\nu(pi/2, 0, pi) qubits[0];","position":{"start":{"line":38,"column":1,"offset":1690},"end":{"line":47,"column":4,"offset":1878}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"量子レジスタへの Uゲート","position":{"start":{"line":49,"column":4,"offset":1883},"end":{"line":49,"column":31,"offset":1910}}}],"position":{"start":{"line":49,"column":1,"offset":1880},"end":{"line":49,"column":31,"offset":1910}}},{"type":"paragraph","children":[{"type":"text","value":"特定のパラメータの組を持つ Uゲートを、量子レジスタのすべての量子ビットに一度に適用することも可能です。","position":{"start":{"line":51,"column":1,"offset":1912},"end":{"line":51,"column":117,"offset":2028}}}],"position":{"start":{"line":51,"column":1,"offset":1912},"end":{"line":51,"column":117,"offset":2028}}},{"type":"paragraph","children":[{"type":"text","value":"量子レジスタ quantum_register のすべての量子ビットに、パラメータ theta、phi、lambda を持つ Uゲートを一度に適用するには、次の構文を使用します。","position":{"start":{"line":53,"column":1,"offset":2030},"end":{"line":53,"column":151,"offset":2180}}}],"position":{"start":{"line":53,"column":1,"offset":2030},"end":{"line":53,"column":151,"offset":2180}}},{"type":"code","lang":"qasm","meta":null,"value":"u(theta, phi, lambda) quantum_regist