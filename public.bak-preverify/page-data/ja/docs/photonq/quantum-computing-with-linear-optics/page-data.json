ia.placeholder.com/150","position":{"start":{"line":52,"column":41,"offset":7187},"end":{"line":52,"column":87,"offset":7233}}}],"children":[],"position":{"start":{"line":52,"column":1,"offset":7147},"end":{"line":52,"column":90,"offset":7236}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"(出典: ArXiv)","position":{"start":{"line":53,"column":2,"offset":7238},"end":{"line":53,"column":17,"offset":7253}}}],"position":{"start":{"line":53,"column":1,"offset":7237},"end":{"line":53,"column":18,"offset":7254}}}],"position":{"start":{"line":53,"column":1,"offset":7237},"end":{"line":53,"column":18,"offset":7254}}}],"position":{"start":{"line":51,"column":1,"offset":7138},"end":{"line":54,"column":10,"offset":7264}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"text","value":"このゲートによって2つのクラスター状態を融合でき、その結果、測定型量子コンピューティングに必要な大きなクラスター状態の生成が可能になります。","position":{"start":{"line":56,"column":1,"offset":7266},"end":{"line":56,"column":161,"offset":7426}}}],"position":{"start":{"line":56,"column":1,"offset":7266},"end":{"line":56,"column":161,"offset":7426}}},{"type":"heading","depth":4,"children":[{"type":"text","value":"タイプIIフュージョンゲート","position":{"start":{"line":58,"column":6,"offset":7433},"end":{"line":58,"column":25,"offset":7452}}}],"position":{"start":{"line":58,"column":1,"offset":7428},"end":{"line":58,"column":25,"offset":7452}}},{"type":"paragraph","children":[{"type":"text","value":"タイプIIフュージョンゲートはタイプIの変形であり、PBS の各ポートに波長板が置かれ、両方の光子が検出されます。このゲートのセットアップは、具体的には次のとおりです。","position":{"start":{"line":60,"column":1,"offset":7454},"end":{"line":60,"column":168,"offset":7621}}}],"position":{"start":{"line":60,"column":1,"offset":7454},"end":{"line":60,"column":168,"offset":7621}}},{"type":"mdxJsxFlowElement","name":"center","attributes":[],"children":[{"type":"mdxJsxFlowElement","name":"Image","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"image-7a1hj","position":{"start":{"line":63,"column":8,"offset":7639},"end":{"line":63,"column":26,"offset":7657}}},{"type":"mdxJsxAttribute","name":"width","value":"300px","position":{"start":{"line":63,"column":27,"offset":7658},"end":{"line":63,"column":40,"offset":7671}}},{"type":"mdxJsxAttribute","name":"defaultValue","value":"https://via.placeholder.com/150","position":{"start":{"line":63,"column":41,"offset":7672},"end":{"line":63,"column":87,"offset":7718}}}],"children":[],"position":{"start":{"line":63,"column":1,"offset":7632},"end":{"line":63,"column":90,"offset":7721}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"(出典: ArXiv)","position":{"start":{"line":65,"column":2,"offset":7724},"end":{"line":65,"column":17,"offset":7739}}}],"position":{"start":{"line":65,"column":1,"offset":7723},"end":{"line":65,"column":18,"offset":7740}}}],"position":{"start":{"line":65,"column":1,"offset":7723},"end":{"line":65,"column":18,"offset":7740}}}],"position":{"start":{"line":62,"column":1,"offset":7623},"end":{"line":66,"column":10,"offset":7750}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"text","value":"このゲートもクラスター状態の生成に使用されます。各検出器でちょうど1個ずつ光子が検出されたとき、このゲートは最大もつれ状態への射影測定を実行します。","position":{"start":{"line":68,"column":1,"offset":7752},"end":{"line":68,"column":191,"offset":7942}}}],"position":{"start":{"line":68,"column":1,"offset":7752},"end":{"line":68,"column":191,"offset":7942}}},{"type":"heading","depth":4,"children":[{"type":"text","value":"ビームスプリッタと HOM 干渉","position":{"start":{"line":70,"column":6,"offset":7949},"end":{"line":70,"column":40,"offset":7983}}}],"position":{"start":{"line":70,"column":1,"offset":7944},"end":{"line":70,"column":40,"offset":7983}}},{"type":"paragraph","children":[{"type":"text","value":"単一のビームスプリッタも、2つの光子に作用するゲートと見なすことができます。2つの同一の光子が、2つの異なる入力ポートから対称ビームスプリッタに同時に入射すると、","position":{"start":{"line":72,"column":1,"offset":7985},"end":{"line":72,"column":233,"offset":8217}}},{"type":"emphasis","children":[{"type":"text","value":"ホン・オウ・マンデル(HOM)干渉","position":{"start":{"line":72,"column":234,"offset":8218},"end":{"line":72,"column":267,"offset":8251}}}],"position":{"start":{"line":72,"column":233,"offset":8217},"end":{"line":72,"column":268,"offset":8252}}},{"type":"text","value":"と呼ばれる純粋に量子的な現象が起こります。これは、2つの光子が決して別々にビームスプリッタから出ていかないことを意味します。両方が一方の出力ポートから出るか、両方が他方の出力ポートから出るかのいずれかです。","position":{"start":{"line":72,"column":268,"offset":8252},"end":{"line":72,"column":407,"offset":8391}}}],"position":{"start":{"line":72,"column":1,"offset":7985},"end":{"line":72,"column":407,"offset":8391}}},{"type":"mdxJsxFlowElement","name":"center","attributes":[],"children":[{"type":"paragraph","children":[{"type":"mdxJsxTextElement","name":"Image","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"image-hom","position":{"start":{"line":75,"column":8,"offset":8409},"end":{"line":75,"column":24,"offset":8425}}},{"type":"mdxJsxAttribute","name":"defaultValue","value":"https://upload.wikimedia.org/wikipedia/commons/a/a9/Hong_Ou_Mandel_effect.png","position":{"start":{"line":75,"column":25,"offset":8426},"end":{"line":75,"column":117,"offset":8518}}}],"children":[{"type":"text","value":"HOM 効果","position":{"start":{"line":75,"column":118,"offset":8519},"end":{"line":75,"column":128,"offset":8529}}}],"position":{"start":{"line":75,"column":1,"offset":8402},"end":{"line":75,"column":136,"offset":8537}},"data":{"_mdxExplicitJsx":true}},{"type":"text","value":"\n","position":{"start":{"line":75,"column":136,"offset":8537},"end":{"line":76,"column":1,"offset":8538}}},{"type":"emphasis","children":[{"type":"text","value":"(出典: Wikipedia)","position":{"start":{"line":76,"column":2,"offset":8539},"end":{"line":76,"column":21,"offset":8558}}}],"position":{"start":{"line":76,"column":1,"offset":8538},"end":{"line":76,"column":22,"offset":8559}}}],"position":{"start":{"line":75,"column":1,"offset":8402},"end":{"line":76,"column":22,"offset":8559}}}],"position":{"start":{"line":74,"column":1,"offset":8393},"end":{"line":77,"column":10,"offset":8569}},"data":{"_mdxExplicitJsx":true}},{"type":"heading","depth":2,"children":[{"type":"text","value":"光学計算アーキテクチャ","position":{"start":{"line":79,"column":4,"offset":8574},"end":{"line":79,"column":35,"offset":8605}}}],"position":{"start":{"line":79,"column":1,"offset":8571},"end":{"line":79,"column":35,"offset":8605}}},{"type":"paragraph","children":[{"type":"text","value":"光学素子とゲートの上に構築される計算アーキテクチャには、さまざまなものがあります。以下では、最も重要な3つのアーキテクチャを紹介します。","position":{"start":{"line":81,"column":1,"offset":8607},"end":{"line":81,"column":155,"offset":8761}}}],"position":{"start":{"line":81,"column":1,"offset":8607},"end":{"line":81,"column":155,"offset":8761}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"ボソンサンプリング","position":{"start":{"line":83,"column":5,"offset":8767},"end":{"line":83,"column":19,"offset":8781}}}],"position":{"start":{"line":83,"column":1,"offset":8763},"end":{"line":83,"column":19,"offset":8781}}},{"type":"paragraph","children":[{"type":"text","value":"ボソンサンプリングとは、多数のビームスプリッタからなる巨大な干渉計に複数の光子を注入し、その後、干渉計の各出力ポートで検出するというシナリオを指します。個々の検出器で光子が検出される出力確率を古典コンピュータで推定するのは非常に困難であることが示されています","position":{"start":{"line":85,"column":1,"offset":8783},"end":{"line":85,"column":361,"offset":9143}}},{"type":"footnoteReference","identifier":"boson","label":"boson","position":{"start":{"line":85,"column":361,"offset":9143},"end":{"line":85,"column":369,"offset":9151}}},{"type":"text","value":"。","position":{"start":{"line":85,"column":369,"offset":9151},"end":{"line":85,"column":370,"offset":9152}}}],"position":{"start":{"line":85,"column":1,"offset":8783},"end":{"line":85,"column":370,"offset":9152}}},{"type":"paragraph","children":[{"type":"text","value":"したがってボソンサンプリングは、実験的要件が比較的控えめであることから、量子優位性を実証するためのプラットフォームとなります。その一方で、このプラットフォームは限られた機能しか提供せず、万能量子コンピューティングを行うことはできません。","position":{"start":{"line":87,"column":1,"offset":9154},"end":{"line":87,"column":266,"offset":9419}}}],"position":{"start":{"line":87,"column":1,"offset":9154},"end":{"line":87,"column":266,"offset":9419}}},{"type":"footnoteDefinition","identifier":"boson","label":"boson","children":[{"type":"paragraph","children":[{"type":"text","value":"Aaronson, Scott, and Alex Arkhipov. “[No Title Found].” Theory of Computing, vol. 9, no. 1, 2013, pp. 143–252. DOI.org (Crossref), ","position":{"start":{"line":89,"column":11,"offset":9431},"end":{"line":89,"column":143,"offset":9563}}},{"type":"link","title":null,"url":"https://doi.org/10.4086/toc.2013.v009a004","children":[{"type":"text","value":"https://doi.org/10.4086/toc.2013.v009a004","position":{"start":{"line":89,"column":144,"offset":9564},"end":{"line":89,"column":185,"offset":9605}}}],"position":{"start":{"line":89,"column":143,"offset":9563},"end":{"line":89,"column":229,"offset":9649}}},{"type":"text","value":".","position":{"start":{"line":89,"column":229,"offset":9649},"end":{"line":89,"column":230,"offset":9650}}}],"position":{"start":{"line":89,"column":11,"offset":9431},"end":{"line":89,"column":230,"offset":9650}}}],"position":{"start":{"line":89,"column":1,"offset":9421},"end":{"line":89,"column":230,"offset":9650}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"KLM 方式","position":{"start":{"line":91,"column":5,"offset":9656},"end":{"line":91,"column":15,"offset":9666}}}],"position":{"start":{"line":91,"column":1,"offset":9652},"end":{"line":91,"column":15,"offset":9666}}},{"type":"paragraph","children":[{"type":"text","value":"スケーラブルな量子コンピューティングを実現するには、さまざまな光子のペアを所定の方法で相互作用させる能力が必要です。そのような相互作用の自然な候補は、伝播する光の強度に応じて性質が変化する、ある種の光学媒質の非線形性です。しかし、このような非線形性は単一光子に対しては知覚できないほど弱いため、実際の応用には適していません。その代わりにできるのは、光子の検出を計算に組み込み、それを利用して実効的な非線形性を誘起することです。この","position":{"start":{"line":93,"column":1,"offset":9668},"end":{"line":93,"column":592,"offset":10259}}},{"type":"emphasis","children":[{"type":"text","value":"測定誘起非線形性","position":{"start":{"line":93,"column":593,"offset":10260},"end":{"line":93,"column":626,"offset":10293}}}],"position":{"start":{"line":93,"column":592,"offset":10259},"end":{"line":93,"column":627,"offset":10294}}},{"type":"text","value":"を活用すると、","position":{"start":{"line":93,"column":627,"offset":10294},"end":{"line":93,"column":707,"offset":10374}}},{"type":"emphasis","children":[{"type":"text","value":"KLM 方式","position":{"start":{"line":93,"column":708,"offset":10375},"end":{"line":93,"column":718,"offset":10385}}}],"position":{"start":{"line":93,"column":707,"offset":10374},"end":{"line":93,"column":719,"offset":10386}}},{"type":"footnoteReference","identifier":"klm","label":"klm","position":{"start":{"line":93,"column":719,"offset":10386},"end":{"line":93,"column":725,"offset":10392}}},{"type":"text","value":"として知られる方式で万能量子計算を実行できます。このアプローチの欠点は、非決定論的であることです。計算は時に失敗し、通常は何度も繰り返す必要があります。","position":{"start":{"line":93,"column":725,"offset":10392},"end":{"line":93,"column":864,"offset":10531}}}],"position":{"start":{"line":93,"column":1,"offset":9668},"end":{"line":93,"column":864,"offset":10531}}},{"type":"footnoteDefinition","identifier":"klm","label":"klm","children":[{"type":"paragraph","children":[{"type":"text","value":"Knill, E., et al. “A Scheme for Efficient Quantum Computation with Linear Optics.” Nature, vol. 409, no. 6816, Jan. 2001, pp. 46–52. DOI.org (Crossref), ","position":{"start":{"line":95,"column":9,"offset":10541},"end":{"line":95,"column":162,"offset":10694}}},{"type":"link","title":null,"url":"https://doi.org/10.1038/35051009","children":[{"type":"text","value":"https://doi.org/10.1038/35051009","position":{"start":{"line":95,"column":163,"offset":10695},"end":{"line":95,"column":195,"offset":10727}}}],"position":{"start":{"line":95,"column":162,"offset":10694},"end":{"line":95,"column":230,"offset":10762}}},{"type":"text","value":".","position":{"start":{"line":95,"column":230,"offset":10762},"end":{"line":95,"column":231,"offset":10763}}}],"position":{"start":{"line":95,"column":9,"offset":10541},"end":{"line":95,"column":231,"offset":10763}}}],"position":{"start":{"line":95,"column":1,"offset":10533},"end":{"line":95,"column":231,"offset":10763}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"測定型方式","position":{"start":{"line":97,"column":5,"offset":10769},"end":{"line":97,"column":29,"offset":10793}}}],"position":{"start":{"line":97,"column":1,"offset":10765},"end":{"line":97,"column":29,"offset":10793}}},{"type":"paragraph","children":[{"type":"text","value":"量子コンピューティングへの有望なアプローチが測定型方式です。この方式では、まず光子を、クラスター状態と呼ばれる巨大なもつれ状態に準備し、計算そのものは単一光子の測定のみで構成されます。こうして、光子を相互作用させる難しさは、最初の段階、すなわちクラスター状態の生成へと移されます。このような状態を光子で効率的に生成する方法は、これまで数多く提案されてきました。最も有望なものの一つが、フュージョンゲートに基づく方法です","position":{"start":{"line":99,"column":1,"offset":10795},"end":{"line":99,"column":513,"offset":11307}}},{"type":"footnoteReference","identifier":"1","label":"1","position":{"start":{"line":99,"column":513,"offset":11307},"end":{"line":99,"column":517,"offset":11311}}},{"type":"text","value":"(上記参照)。この方法では、フュージョンゲートを繰り返し適用することで、小さなクラスター状態がより大きなものへと結合されていきます。","position":{"start":{"line":99,"column":517,"offset":11311},"end":{"line":99,"column":626,"offset":11420}}}],"position":{"start":{"line":99,"column":1,"offset":10795},"end":{"line":99,"column":626,"offset":11420}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":100,"column":1,"offset":11421}}},"props":{}}},"IMA:ImageField":{"image-q9rd6h":{"value":null,"props":{}},"image-td28w":{"value":"cfa46886-9171-461a-a24c-23a25e99e16d","props":{}},"image-t3kpu":{"value":"8240095d-76de-455e-871c-af5b59982660","props":{}},"image-7a1hj":{"value":"46154c9c-0e43-48af-88be-f34819535c96","props":{}}}},"parentPage":{"id":"JaenPage dcaece63-8a0f-5000-ae56-01d2c3d76c92","createdAt":"2026-08-12T08:32:43.899Z","modifiedAt":"2026-08-12T08:32:43.899Z","buildPath":"/ja/docs/photonq/","slug":"photonq","template":"JaenTemplate DocPage","excludedFromIndex":false,"jaenPageMetadata":{"title":"PhotonQ","image":"https://net