からは不可視でした。私の解決策はこうです。ext-workspace-v1 の実装をバックポートしたパッチ済み wlroots 0.19.2、それに Wayfire のワークスペースをこのプロトコル経由で公開するプラグイン ","position":{"start":{"line":54,"column":69,"offset":2504},"end":{"line":54,"column":286,"offset":2721}}},{"type":"inlineCode","value":"wlr-workspaces","position":{"start":{"line":54,"column":286,"offset":2721},"end":{"line":54,"column":302,"offset":2737}}},{"type":"text","value":" を載せた Wayfire 0.10.1。どちらのパッケージも私の ","position":{"start":{"line":54,"column":302,"offset":2737},"end":{"line":54,"column":336,"offset":2771}}},{"type":"link","title":null,"url":"/docs/linux/rpm","children":[{"type":"text","value":"RPM リポジトリ","position":{"start":{"line":54,"column":337,"offset":2772},"end":{"line":54,"column":346,"offset":2781}}}],"position":{"start":{"line":54,"column":336,"offset":2771},"end":{"line":54,"column":364,"offset":2799}}},{"type":"text","value":"から来ています。これで XFCE のページャーはボタンモードですべてのワークスペースを表示し、ページャー内のクリックでワークスペースが切り替わります。そのためにはパネルが少なくともバージョン 4.20.1 である必要があります。4.20.0 には ext-workspace のバグが含まれています。依然として欠けているものもあります。このプロトコルはウィンドウとワークスペースの対応付けを知らないため、サムネイル型ページャーもワークスペースごとの壁紙もありません。","position":{"start":{"line":54,"column":364,"offset":2799},"end":{"line":54,"column":597,"offset":3032}}}],"position":{"start":{"line":54,"column":1,"offset":2436},"end":{"line":54,"column":597,"offset":3032}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"オーディオ: PipeWire","position":{"start":{"line":56,"column":4,"offset":3037},"end":{"line":56,"column":19,"offset":3052}}}],"position":{"start":{"line":56,"column":1,"offset":3034},"end":{"line":56,"column":19,"offset":3052}}},{"type":"paragraph","children":[{"type":"text","value":"オーディオは PipeWire 1.4 と WirePlumber 0.5 で動いています。","position":{"start":{"line":58,"column":1,"offset":3054},"end":{"line":58,"column":47,"offset":3100}}},{"type":"inlineCode","value":"pipewire-pulseaudio","position":{"start":{"line":58,"column":47,"offset":3100},"end":{"line":58,"column":68,"offset":3121}}},{"type":"text","value":" パッケージが