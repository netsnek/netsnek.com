,"offset":6752},"end":{"line":49,"column":50,"offset":6764}}}],"position":{"start":{"line":49,"column":37,"offset":6751},"end":{"line":49,"column":51,"offset":6765}}},{"type":"text","value":", sprejmejo dva fotona in preverijo, ali imata enako polarizacijo, bodisi vodoravno bodisi navpično. Če jo imata, je en foton zaznan, drugi pa vrnjen. Vrata sestavljajo PBS, valovna ploščica, ki polarizacijo zavrti za 45 stopinj, in detektor posameznih fotonov, nameščen na enem od izhodnih vrat PBS. Celotna postavitev je prikazana na spodnji sliki:","position":{"start":{"line":49,"column":51,"offset":6765},"end":{"line":49,"column":422,"offset":7136}}}],"position":{"start":{"line":49,"column":1,"offset":6715},"end":{"line":49,"column":422,"offset":7136}}},{"type":"mdxJsxFlowElement","name":"center","attributes":[],"children":[{"type":"mdxJsxFlowElement","name":"Image","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"image-t3kpu","position":{"start":{"line":52,"column":8,"offset":7154},"end":{"line":52,"column":26,"offset":7172}}},{"type":"mdxJsxAttribute","name":"width","value":"300px","position":{"start":{"line":52,"column":27,"offset":7173},"end":{"line":52,"column":40,"offset":7186}}},{"type":"mdxJsxAttribute","name":"defaultValue","value":"https://via.placeholder.com/150","position":{"start":{"line":52,"column":41,"offset":7187},"end":{"line":52,"column":87,"offset":7233}}}],"children":[],"position":{"start":{"line":52,"column":1,"offset":7147},"end":{"line":52,"column":90,"offset":7236}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"(vir: ArXiv)","position":{"start":{"line":53,"column":2,"offset":7238},"end":{"line":53,"column":17,"offset":7253}}}],"position":{"start":{"line":53,"column":1,"offset":7237},"end":{"line":53,"column":18,"offset":7254}}}],"position":{"start":{"line":53,"column":1,"offset":7237},"end":{"line":53,"column":18,"offset":7254}}}],"position":{"start":{"line":51,"col