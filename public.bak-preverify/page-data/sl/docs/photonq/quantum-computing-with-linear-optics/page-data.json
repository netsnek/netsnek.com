data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"(vir: ArXiv)","position":{"start":{"line":65,"column":2,"offset":7724},"end":{"line":65,"column":17,"offset":7739}}}],"position":{"start":{"line":65,"column":1,"offset":7723},"end":{"line":65,"column":18,"offset":7740}}}],"position":{"start":{"line":65,"column":1,"offset":7723},"end":{"line":65,"column":18,"offset":7740}}}],"position":{"start":{"line":62,"column":1,"offset":7623},"end":{"line":66,"column":10,"offset":7750}},"data":{"_mdxExplicitJsx":true}},{"type":"paragraph","children":[{"type":"text","value":"Tudi ta vrata se uporabljajo pri tvorbi grozdnih stanj. Kadar vsak detektor zazna natanko en foton, vrata izvedejo projektivno meritev na maksimalno prepleteno stanje.","position":{"start":{"line":68,"column":1,"offset":7752},"end":{"line":68,"column":191,"offset":7942}}}],"position":{"start":{"line":68,"column":1,"offset":7752},"end":{"line":68,"column":191,"offset":7942}}},{"type":"heading","depth":4,"children":[{"type":"text","value":"Delilnik žarka in interferenca HOM","position":{"start":{"line":70,"column":6,"offset":7949},"end":{"line":70,"column":40,"offset":7983}}}],"position":{"start":{"line":70,"column":1,"offset":7944},"end":{"line":70,"column":40,"offset":7983}}},{"type":"paragraph","children":[{"type":"text","value":"Tudi posamezen delilnik žarka lahko razumemo kot vrata, ki delujejo na dva fotona. Kadar dva enaka fotona hkrati vpadeta na simetrični delilnik žarka skozi različni vhodni vrati, doživita povsem kvantni pojav, imenovan ","position":{"start":{"line":72,"column":1,"offset":7985},"end":{"line":72,"column":233,"offset":8217}}},{"type":"emphasis","children":[{"type":"text","value":"interferenca Hong-Ou-Mandel (HOM)","position":{"start":{"line":72,"column":234,"offset":8218},"end":{"line":72,"column":267,"offset":8251}}}],"position":{"start":{"line":72,"column":233,"offset":8217},"end":{"line":72,"column":268,"offset":8252}}},{"type":"text","value":". To pomeni, da fotona delilnika žarka nikoli ne zapustita ločeno: bodisi oba odideta skozi ena bodisi oba skozi druga izhodna vrata.","position":{"start":{"line":72,"column":268,"offset":8252},"end":{"line":72,"column":407,"offset":8391}}}],"position":{"start":{"line":72,"column":1,"offset":7985},"end":{"line":72,"column":407,"offset":8391}}},{"type":"mdxJsxFlowElement","name":"center","attributes":[],"children":[{"type":"paragraph","children":[{"type":"mdxJsxTextElement","name":"Image","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"image-hom","position":{"start":{"line":75,"column":8,"offset":8409},"end":{"line":75,"column":24,"offset":8425}}},{"type":"mdxJsxAttribute","name":"defaultValue","value":"https://upload.wikimedia.org/wikipedia/commons/a/a9/Hong_Ou_Mandel_effect.png","position":{"start":{"line":75,"column":25,"offset":8426},"end":{"line":75,"column":117,"offset":8518}}}],"children":[{"type":"text","value":"Pojav HOM","position":{"start":{"line":75,"column":118,"offset":8519},"end":{"line":75,"column":128,"offset":8529}}}],"position":{"start":{"line":75,"column":1,"offset":8402},"end":{"line":75,"column":136,"offset":8537}},"data":{"_mdxExplicitJsx":true}},{"type":"text","value":"\n","position":{"start":{"line":75,"column":136,"offset":8537},"end":{"line":76,"column":1,"offset":8538}}},{"type":"emphasis","children":[{"type":"text","value":"(vir: Wikipedia)","position":{"start":{"line":76,"column":2,"offset":8539},"end":{"line":76,"column":21,"offset":8558}}}],"position":{"start":{"line":76,"column":1,"offset":8538},"end":{"line":76,"column":22,"offset":8559}}}],"position":{"start":{"line":75,"column":1,"offset":8402},"end":{"line":76,"column":22,"offset":8559}}}],"position":{"start":{"line":74,"column":1,"offset":8393},"end":{"line":77,"column":10,"offset":8569}},"data":{"_mdxExplicitJsx":true}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Optične računske arhitekture","position":{"start":{"line":79,"column":4,"offset":8574},"end":{"line":79,"column":35,"offset":8605}}}],"position":{"start":{"line":79,"column":1,"offset":8571},"end":{"line":79,"column":35,"offset":8605}}},{"type":"paragraph","children":[{"type":"text","value":"Na optičnih elementih in vratih so zgrajene različne računske arhitekture. Spodaj so predstavljene tri najpomembnejše.","position":{"start":{"line":81,"column":1,"offset":8607},"end":{"line":81,"column":155,"offset":8761}}}],"position":{"start":{"line":81,"column":1,"offset":8607},"end":{"line":81,"column":155,"offset":8761}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Bozonsko vzorčenje","position":{"start":{"line":83,"column":5,"offset":8767},"end":{"line":83,"column":19,"offset":8781}}}],"position":{"start":{"line":83,"column":1,"offset":8763},"end":{"line":83,"column":19,"offset":8781}}},{"type":"paragraph","children":[{"type":"text","value":"Bozonsko vzorčenje označuje scenarij, pri katerem več fotonov pošljemo v ogromen interferometer, sestavljen iz številnih delilnikov žarka, nato pa jih zaznamo na vsakih izhodnih vratih interferometra. Mogoče je pokazati, da klasični računalnik zelo težko oceni izhodne verjetnosti, s katerimi fotone zaznajo posamezni detektorji","position":{"start":{"line":85,"column":1,"offset":8783},"end":{"line":85,"column":361,"offset":9143}}},{"type":"footnoteReference","identifier":"boson","label":"boson","position":{"start":{"line":85,"column":361,"offset":9143},"end":{"line":85,"column":369,"offset":9151}}},{"type":"text","value":".","position":{"start":{"line":85,"column":369,"offset":9151},"end":{"line":85,"column":370,"offset":9152}}}],"position":{"start":{"line":85,"column":1,"offset":8783},"end":{"line":85,"column":370,"offset":9152}}},{"type":"paragraph","children":[{"type":"text","value":"Bozonsko vzorčenje tako predstavlja platformo za demonstracijo kvantne prednosti, saj so njegove eksperimentalne zahteve razmeroma skromne. Po drugi strani pa ta platforma ponuja le omejeno funkcionalnost in ne omogoča univerzalnega kvantnega računalništva.","position":{"start":{"line":87,"column":1,"offset":9154},"end":{"line":87,"column":266,"offset":9419}}}],"position":{"start":{"line":87,"column":1,"offset":9154},"end":{"line":87,"column":266,"offset":9419}}},{"type":"footnoteDefinition","identifier":"boson","label":"boson","children":[{"type":"paragraph","children":[{"type":"text","value":"Aaronson, Scott, and Alex Arkhipov. “[No Title Found].” Theory of Computing, vol. 9, no. 1, 2013, pp. 143–252. DOI.org (Crossref), ","position":{"start":{"line":89,"column":11,"offset":9431},"end":{"line":89,"column":143,"offset":9563}}},{"type":"link","title":null,"url":"https://doi.org/10.4086/toc.2013.v009a004","children":[{"type":"text","value":"https://doi.org/10.4086/toc.2013.v009a004","position":{"start":{"line":89,"column":144,"offset":9564},"end":{"line":89,"column":185,"offset":9605}}}],"position":{"start":{"line":89,"column":143,"offset":9563},"end":{"line":89,"column":229,"offset":9649}}},{"type":"text","value":".","position":{"start":{"line":89,"column":229,"offset":9649},"end":{"line":89,"column":230,"offset":9650}}}],"position":{"start":{"line":89,"column":11,"offset":9431},"end":{"line":89,"column":230,"offset":9650}}}],"position":{"start":{"line":89,"column":1,"offset":9421},"end":{"line":89,"column":230,"offset":9650}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Shema KLM","position":{"start":{"line":91,"column":5,"offset":9656},"end":{"line":91,"column":15,"offset":9666}}}],"position":{"start":{"line":91,"column":1,"offset":9652},"end":{"line":91,"column":15,"offset":9666}}},{"type":"paragraph","children":[{"type":"text","value":"Za dosego skalabilnega kvantnega računalništva moramo imeti možnost, da na predpisan način med seboj sklopimo različne pare fotonov. Naravni kandidat za takšno interakcijo so nelinearne lastnosti nekaterih optičnih medijev, ki se spreminjajo glede na intenziteto svetlobe, ki se v njih širi. Takšne nelinearne lastnosti pa so prešibke, da bi bile opazne pri posameznih fotonih, in zato niso primerne za resnične aplikacije. Namesto tega lahko v izračun vključimo detekcijo fotona in jo uporabimo za vzpostavitev efektivne nelinearnosti. To ","position":{"start":{"line":93,"column":1,"offset":9668},"end":{"line":93,"column":592,"offset":10259}}},{"type":"emphasis","children":[{"type":"text","value":"z meritvijo povzročeno nelinearnost","position":{"start":{"line":93,"column":593,"offset":10260},"end":{"line":93,"column":626,"offset":10293}}}],"position":{"start":{"line":93,"column":592,"offset":10259},"end":{"line":93,"column":627,"offset":10294}}},{"type":"text","value":" lahko izkoristimo za univerzalno kvantno računanje v shemi, znani kot ","position":{"start":{"line":93,"column":627,"offset":10294},"end":{"line":93,"column":707,"offset":10374}}},{"type":"emphasis","children":[{"type":"text","value":"shema KLM","position":{"start":{"line":93,"column":708,"offset":10375},"end":{"line":93,"column":718,"offset":10385}}}],"position":{"start":{"line":93,"column":707,"offset":10374},"end":{"line":93,"column":719,"offset":10386}}},{"type":"footnoteReference","identifier":"klm","label":"klm","position":{"start":{"line":93,"column":719,"offset":10386},"end":{"line":93,"column":725,"offset":10392}}},{"type":"text","value":". Slabost tega pristopa je, da ni determinističen: včasih izračun spodleti in ga je običajno treba večkrat ponoviti.","position":{"start":{"line":93,"column":725,"offset":10392},"end":{"line":93,"column":864,"offset":10531}}}],"position":{"start":{"line":93,"column":1,"offset":9668},"end":{"line":93,"column":864,"offset":10531}}},{"type":"footnoteDefinition","identifier":"klm","label":"klm","children":[{"type":"paragraph","children":[{"type":"text","value":"Knill, E., et al. “A Scheme for Efficient Quantum Computation with Linear Optics.” Nature, vol. 409, no. 6816, Jan. 2001, pp. 46–52. DOI.org (Crossref), ","position":{"start":{"line":95,"column":9,"offset":10541},"end":{"line":95,"column":162,"offset":10694}}},{"type":"link","title":null,"url":"https://doi.org/10.1038/35051009","children":[{"type":"text","value":"https://doi.org/10.1038/35051009","position":{"start":{"line":95,"column":163,"offset":10695},"end":{"line":95,"column":195,"offset":10727}}}],"position":{"start":{"line":95,"column":162,"offset":10694},"end":{"line":95,"column":230,"offset":10762}}},{"type":"text","value":".","position":{"start":{"line":95,"column":230,"offset":10762},"end":{"line":95,"column":231,"offset":10763}}}],"position":{"start":{"line":95,"column":9,"offset":10541},"end":{"line":95,"column":231,"offset":10763}}}],"position":{"start":{"line":95,"column":1,"offset":10533},"end":{"line":95,"column":231,"offset":10763}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Shema na osnovi meritev","position":{"start":{"line":97,"column":5,"offset":10769},"end":{"line":97,"column":29,"offset":10793}}}],"position":{"start":{"line":97,"column":1,"offset":10765},"end":{"line":97,"column":29,"offset":10793}}},{"type":"paragraph","children":[{"type":"text","value":"Obetaven pristop h kvantnemu računalništvu je shema na osnovi meritev, pri kateri fotone najprej pripravimo v ogromnem prepletenem stanju, imenovanem grozdno stanje, sam izračun pa nato sestoji zgolj iz meritev posameznih fotonov. Težavnost interakcije fotonov se tako prenese na sam začetek, torej na tvorbo grozdnega stanja. Obstaja veliko predlogov, kako takšna stanja s fotoni učinkovito ustvariti. Eden najobetavnejših temelji na fuzijskih vratih","position":{"start":{"line":99,"column":1,"offset":10795},"end":{"line":99,"column":513,"offset":11307}}},{"type":"footnoteReference","identifier":"1","label":"1","position":{"start":{"line":99,"column":513,"offset":11307},"end":{"line":99,"column":517,"offset":11311}}},{"type":"text","value":", glej zgoraj, kjer se majhna grozdna stanja s ponavljajočo se uporabo fuzijskih vrat združujejo v večja.","position":{"star