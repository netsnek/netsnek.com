inc\";         // Include the standard quantum library [^2]\n\n// Quantum register with a single qubit and classical register with two bits\nqreg qubit[1];                // Single-qubit quantum register [^4]\ncreg bits[2];                 // Two-bit classical register [^3]\n\n// Prepare qubit in a superposition state\nh qubit[0];                   // Apply Hadamard gate to the qubit [^5]\n\n// Measure the qubit and store the result in the first bit of classical register\nmeasure qubit[0] -> bits[0];  // Measurement operation [^6]\n\n// The second bit remains in its initial state (0)","position":{"start":{"line":21,"column":1,"offset":1061},"end":{"line":36,"column":4,"offset":1740}}},{"type":"paragraph","children":[{"type":"text","value":"V tem združenem poskusu kvantni register vsebuje en sam kubit, ki ga s Hadamardovimi vrati pripravimo v superpozicijsko stanje. Nato izmerimo stanje kubita in rezultat meritve shranimo v prvi bit našega dvobitnega klasičnega registra. Drugi bit registra ostane nespremenjen in prikazuje možnost shranjevanja več izidov meritev ali uporabe dodatnih bitov za druge klasične izračune.","position":{"start":{"line":38,"column":1,"offset":1742},"end":{"line":38,"column":421,"offset":2162}}}],"position":{"start":{"line":38,"column":1,"offset":1742},"end":{"line":38,"column":421,"offset":2162}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Enobitni klasični registri","position":{"start":{"line":40,"column":5,"offset":2168},"end":{"line":40,"column":35,"offset":2198}}}],"position":{"start":{"line":40,"column":1,"offset":2164},"end":{"line":40,"column":35,"offset":2198}}},{"type":"paragraph","children":[{"type":"text","value":"Čeprav OpenQASM ne omogoča deklaracije posameznih klasičnih bitov, lahko za primere, ko potrebujete le en bit, deklarirate enobitni register:","position":{"start":{"line":42,"column":1,"offset":2200},"end":{"line":42,"column":144,"offset":2343}}}],"position":{"start":{"line":42,"column":1,"offset":2200