{"componentChunkName":"component---src-templates-doc-page-tsx","path":"/it/docs/jaen/","result":{"data":{"jaenPage":{"id":"JaenPage 63c495ab-7ba9-5fb5-9313-1a2571bc87b6","createdAt":"2026-08-12T08:32:43.887Z","modifiedAt":"2026-08-12T08:32:43.887Z","buildPath":"/it/docs/jaen/","slug":"jaen","template":"JaenTemplate DocPage","excludedFromIndex":false,"jaenPageMetadata":{"title":"Jaen","image":"https://netsnek.com/images/docs/jaen.jpg","description":"Il progetto CMS che sviluppo con Nico. Insieme proviamo a portare il content management nel XXI secolo. Questo sito qui ci gira sopra.","blogPost":{"date":"2025-09-26","author":null,"category":"Jaen"}},"pageConfig":{"label":"DocPage","childTemplates":["JaenTemplate DocPage"],"withoutJaenFrameStickyHeader":true},"jaenFields":{"IMA:MdxField":{"documentation":{"value":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"Jaen","position":{"start":{"line":2,"column":3,"offset":3},"end":{"line":2,"column":7,"offset":7}}}],"position":{"start":{"line":2,"column":1,"offset":1},"end":{"line":2,"column":7,"offset":7}}},{"type":"paragraph","children":[{"type":"text","value":"Quasi ogni progetto in questo blog poggia sulle stesse fondamenta, quindi anche la sua storia sta qui. Jaen è il CMS che sviluppo insieme a ","position":{"start":{"line":4,"column":1,"offset":9},"end":{"line":4,"column":141,"offset":149}}},{"type":"link","title":null,"url":"https://github.com/schettn","children":[{"type":"text","value":"Nico","position":{"start":{"line":4,"column":142,"offset":150},"end":{"line":4,"column":146,"offset":154}}}],"position":{"start":{"line":4,"column":141,"offset":149},"end":{"line":4,"column":175,"offset":183}}},{"type":"text","value":" di ","position":{"start":{"line":4,"column":175,"offset":183},"end":{"line":4,"column":179,"offset":187}}},{"type":"link","title":null,"url":"https://www.cronit.io","children":[{"type":"text","value":"cronit","position":{"start":{"line":4,"column":180,"offset":1