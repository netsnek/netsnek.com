,"end":{"line":10,"column":141,"offset":1052}}},{"type":"inlineCode","value":"gpgcheck=1","position":{"start":{"line":10,"column":141,"offset":1052},"end":{"line":10,"column":153,"offset":1064}}},{"type":"text","value":" e la chiave pubblica. I metadati li genero comunque con ","position":{"start":{"line":10,"column":153,"offset":1064},"end":{"line":10,"column":210,"offset":1121}}},{"type":"inlineCode","value":"createrepo","position":{"start":{"line":10,"column":210,"offset":1121},"end":{"line":10,"column":222,"offset":1133}}},{"type":"text","value":", dnf tratta poi il repository come qualsiasi altro. Fino ad allora vale questo: chi ha bisogno di uno dei pacchetti si fa vivo attraverso i contatti indicati su ","position":{"start":{"line":10,"column":222,"offset":1133},"end":{"line":10,"column":384,"offset":1295}}},{"type":"link","title":null,"url":"https://netsnek.com","children":[{"type":"text","value":"netsnek.com","position":{"start":{"line":10,"column":385,"offset":1296},"end":{"line":10,"column":396,"offset":1307}}}],"position":{"start":{"line":10,"column":384,"offset":1295},"end":{"line":10,"column":418,"offset":1329}}},{"type":"text","value":", e guardiamo insieme che cosa abbia senso per il computer in questione.","position":{"start":{"line":10,"column":418,"offset":1329},"end":{"line":10,"column":490,"offset":1401}}}],"position":{"start":{"line":10,"column":1,"offset":912},"end":{"line":10,"column":490,"offset":1401}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Precedenza su Fedora","position":{"start":{"line":12,"column":4,"offset":1406},"end":{"line":12,"column":24,"offset":1426}}}],"position":{"start":{"line":12,"column":1,"offset":1403},"end":{"line":12,"column":24,"offset":1426}}},{"type":"paragraph","children":[{"type":"text","value":"I pacchetti portano i loro nomi upstream originali, quindi per esempio ","position":{"start":{"line":14,"column":1,"offset":1428},"end":{"line":14,"column":72,"offset":1499}}},{"type":"inlineCode","