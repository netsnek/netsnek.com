         "offset": 454
        }
       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Vrata U s parametri θ, φ in λ lahko obravnavamo kot enakovredna naslednjim operacijam: RZ(φ) RY(θ) RZ(λ)",
         "position": {
          "start": {
           "line": 7,
           "column": 1,
           "offset": 456
          },
          "end": {
           "line": 7,
           "column": 116,
           "offset": 571
          }
         }
        }
       ],
       "position": {
        "start": {
         "line": 7,
         "column": 1,
         "offset": 456
        },
        "end": {
         "line": 7,
         "column": 116,
         "offset": 571
        }
       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "pri čemer je RZ(x) vrtenje okoli osi Z na Blochovi sferi za x radianov, RY(x) pa vrtenje okoli osi Y na Blochovi sferi za x radianov.",
         "position": {
          "start": {
           "line": 9,
