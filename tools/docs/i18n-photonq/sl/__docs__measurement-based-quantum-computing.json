       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Načelo delovanja te sheme lahko razumemo kot posplošitev kvantne\nteleportacije, temeljnega postopka kvantne obdelave informacij, ki je bil predstavljen leta 1993",
         "position": {
          "start": {
           "line": 19,
           "column": 1,
           "offset": 917
          },
          "end": {
           "line": 20,
