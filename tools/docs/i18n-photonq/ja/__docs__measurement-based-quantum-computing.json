           "line": 20,
           "column": 86,
           "offset": 1092
          }
         }
        },
        {
         "type": "text",
         "value": "、1999 年に実証されました",
         "position": {
          "start": {
           "line": 20,
           "column": 86,
           "offset": 1092
          },
          "end": {
           "line": 21,
           "column": 25,
