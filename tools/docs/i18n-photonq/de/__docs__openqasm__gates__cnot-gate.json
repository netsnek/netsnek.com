      },
      {
       "type": "code",
       "lang": "qasm",
       "meta": "playground",
       "value": "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n\n// Define quantum registers\nqreg qubits[2];\n\n// Apply CX gate\ncx qubits[0], qubits[1];",
