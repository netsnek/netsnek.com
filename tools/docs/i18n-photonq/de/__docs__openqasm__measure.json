              "value": "OPENQASM 2.0;                 // Define the OpenQASM version [^1]\ninclude \"qelib1.inc\";         // Include the standard library [^2]\n\n// Declaration of quantum and classical registers\nqreg qubit[1];                // Single-qubit quantum register [^3]\ncreg bit[1];                  // Single-bit classical register [^3]\n\n// Measure the qubit and save the result in the classical bit\nmeasure qubit[0] -> bit[0];   // Measurement command [^4]",
