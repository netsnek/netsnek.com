              }
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Zum Beispiel ist das H-Gatter ein Spezialfall des U-Gatters mit den Werten θ = π/2, φ = 0 und λ = π.",
                  "position": {
                    "start": {
                      "line": 21,
                      "column": 1,
                      "offset": 993
                    },
                    "end": {
                      "line": 21,
                      "column": 90,
                      "offset": 1082
                    }
