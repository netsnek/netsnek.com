                  "column": 214,
                  "offset": 1688
                }
              }
            },
            {
              "type": "code",
              "lang": "qasm",
              "meta": "playground",
              "value": "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n\n// Define quantum registers\nqreg qubits[1];\n\n// Applying H gate on the first Qubit of Quantum Register\nu(pi/2, 0, pi) qubits[0];",
              "position": {
