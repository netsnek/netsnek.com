         "value": "image-wflcy"
        },
        {
         "type": "mdxJsxAttribute",
         "name": "defaultValue",
         "value": "https://via.placeholder.com/150"
        }
       ],
       "children": [],
       "data": {
        "_mdxExplicitJsx": true
       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Usiamo il valore di "
        },
        {
         "type": "inlineMath",
         "value": "\\alpha",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\alpha"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " sull'asse x e il valore di "
        },
        {
         "type": "inlineMath",
         "value": "\\beta",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\beta"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " sull'asse y.\nPoiché "
        },
        {
         "type": "inlineMath",
         "value": "|\\alpha|^2+|\\beta|^2=1",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "|\\alpha|^2+|\\beta|^2=1"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": ", i qubit giacciono sempre esattamente sulla circonferenza tratteggiata."
        }
       ]
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Per un qubit con ampiezze complesse, cioè "
        },
        {
         "type": "inlineMath",
         "value": "\\alpha, \\beta\\in\\mathbb{C}",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\alpha, \\beta\\in\\mathbb{C}"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": ", possiamo comunque rappresentarlo con sole tre dimensioni utilizzando la cosiddetta "
        },
        {
         "type": "strong",
         "children": [
          {
           "type": "text",
           "value": "sfera di Bloch"
          }
         ]
        },
        {
         "type": "text",
         "value": ":"
        }
       ]
      },
      {
       "type": "mdxJsxFlowElement",
       "name": "Image",
       "attributes": [
        {
         "type": "mdxJsxAttribute",
         "name": "width",
         "value": "300px"
        },
        {
         "type": "mdxJsxAttribute",
         "name": "name",
         "value": "image-ccxrh"
        },
        {
         "type": "mdxJsxAttribute",
         "name": "defaultValue",
         "value": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6b/Bloch_sphere.svg/1280px-Bloch_sphere.svg.png"
        }
       ],
       "children": [],
       "data": {
        "_mdxExplicitJsx": true
       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Attraverso alcune trasformazioni, possiamo convertire la formula del qubit della sezione precedente nella forma seguente"
        }
       ]
      },
      {
       "type": "math",
       "meta": null,
       "value": " \\ket{\\psi} = \\cos\\left(\\frac{\\theta}{2}\\right)\\ket{0} + \\sin\\left(\\frac{\\theta}{2}\\right)e^{i\\phi}\\ket{1}",
       "data": {
        "hName": "pre",
        "hChildren": [
         {
          "type": "element",
          "tagName": "code",
          "properties": {
           "className": [
            "language-math",
            "math-display"
           ]
          },
          "children": [
           {
            "type": "text",
            "value": " \\ket{\\psi} = \\cos\\left(\\frac{\\theta}{2}\\right)\\ket{0} + \\sin\\left(\\frac{\\theta}{2}\\right)e^{i\\phi}\\ket{1}"
           }
          ]
         }
        ]
       }
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "dove "
        },
        {
         "type": "inlineMath",
         "value": "0\\leq\\theta\\leq\\pi",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "0\\leq\\theta\\leq\\pi"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " e "
        },
        {
         "type": "inlineMath",
         "value": "0\\leq\\phi\\leq2\\pi",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "0\\leq\\phi\\leq2\\pi"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": "."
        }
       ]
      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "inlineMath",
         "value": "\\theta",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\theta"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " e "
        },
        {
         "type": "inlineMath",
         "value": "\\phi",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\phi"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " sono sufficienti a descrivere completamente una rotazione sulla sfera di Bloch, dove "
        },
        {
         "type": "inlineMath",
         "value": "\\phi",
         "data": {
          "hName": "code",
          "hProperties": {
           "className": [
            "language-math",
            "math-inline"
           ]
          },
          "hChildren": [
           {
            "type": "text",
            "value": "\\phi"
           }
          ]
         }
        },
        {
         "type": "text",
         "value": " è anche detta "
        },
        {
         "type": "emphasis",
         "children": [
          {
           "type": "text",
           "value": "fase (relativa)"
          }
         ]
        },
        {
         "type": "text",
