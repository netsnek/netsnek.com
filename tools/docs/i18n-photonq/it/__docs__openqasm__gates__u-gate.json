      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Ad esempio, la porta H è un caso particolare della porta U quando il valore di θ = π/2, φ = 0 , λ = π.",
         "position": {
          "start": {
           "line": 21,
           "column": 1,
           "offset": 993
          },
          "end": {
           "line": 21,
           "column": 90,
           "offset": 1082
          }
