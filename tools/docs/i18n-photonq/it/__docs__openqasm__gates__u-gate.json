      },
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Di seguito un esempio di applicazione della porta U al primo qubit del registro quantistico qubits con parametri θ = π/2, φ = 0 , λ = π. Applicare la porta U con questi parametri equivale ad applicare la porta H al qubit.",
         "position": {
          "start": {
           "line": 36,
           "column": 1,
           "offset": 1475
          },
          "end": {
           "line": 36,
           "column": 214,
           "offset": 1688
