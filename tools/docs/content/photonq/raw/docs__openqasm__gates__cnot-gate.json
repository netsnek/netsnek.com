                }
              }
            },
            {
              "type": "heading",
              "depth": 3,
              "children": [
                {
                  "type": "text",
                  "value": "Example",
                  "position": {
                    "start": {
                      "line": 19,
                      "column": 5,
                      "offset": 969
                    },
                    "end": {
                      "line": 19,
                      "column": 12,
