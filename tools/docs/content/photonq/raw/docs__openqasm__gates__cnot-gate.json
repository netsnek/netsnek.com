                },
                "end": {
                  "line": 19,
                  "column": 12,
                  "offset": 976
                }
              }
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Below is an example of applying the CNOT Gate with control Qubit as first Qubit of Quantum Register qubits and target qubit as second Qubit of Quantum Register qubits–",
                  "position": {
                    "start": {
                      "line": 21,
                      "column": 1,
                      "offset": 978
                    },
                    "end": {
                      "line": 21,
                      "column": 168,
                      "offset": 1145
                    }
                  }
                }
              ],
              "position": {
                "start": {
                  "line": 21,
                  "column": 1,
                  "offset": 978
                },
                "end": {
                  "line": 21,
                  "column": 168,
                  "offset": 1145
                }
              }
            },
            {
              "type": "code",
              "lang": "qasm",
              "meta": "playground",
              "value": "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n\n// Define quantum registers\nqreg qubits[2];\n\n// Apply CX gate\ncx qubits[0], qubits[1];",
              "position": {
                "start": {
                  "line": 23,
                  "column": 1,
                  "offset": 1147
                },
                "end": {
                  "line": 32,
                  "column": 4,
                  "offset": 1293
                }
              }
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "strong",
                  "children": [
                    {
                      "type": "text",
                      "value": "Note:",
                      "position": {
                        "start": {
                          "line": 34,
                          "column": 3,
                          "offset": 1297
                        },
                        "end": {
                          "line": 34,
                          "column": 8,
                          "offset": 1302
                        }
                      }
                    }
                  ],
                  "position": {
                    "start": {
                      "line": 34,
                      "column": 1,
                      "offset": 1295
                    },
                    "end": {
                      "line": 34,
                      "column": 10,
                      "offset": 1304
                    }
                  }
                },
                {
                  "type": "text",
                  "value": " The control and target Qubits can both be in the same as well as different Quantum Register.",
                  "position": {
                    "start": {
