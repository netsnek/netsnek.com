                "end": {
                  "line": 9,
                  "column": 178,
                  "offset": 971
                }
              }
            },
            {
              "type": "heading",
              "depth": 3,
              "children": [
                {
                  "type": "text",
                  "value": "Why Learn OpenQASM?",
