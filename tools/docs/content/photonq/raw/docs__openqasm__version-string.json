                },
                "end": {
                  "line": 3,
                  "column": 366,
                  "offset": 417
                }
              }
            },
            {
              "type": "heading",
              "depth": 2,
              "children": [
                {
                  "type": "text",
                  "value": "What is the OpenQASM Version String?",
                  "position": {
                    "start": {
                      "line": 5,
                      "column": 4,
                      "offset": 422
                    },
                    "end": {
                      "line": 5,
                      "column": 40,
                      "offset": 458
                    }
                  }
                }
              ],
              "position": {
                "start": {
                  "line": 5,
                  "column": 1,
                  "offset": 419
                },
                "end": {
                  "line": 5,
                  "column": 40,
                  "offset": 458
                }
              }
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "The version string is an essential directive at the beginning of an OpenQASM file that specifies the version of the language used. This directive ensures compatibility and proper interpretation across different quantum processing environments.",
                  "position": {
                    "start": {
                      "line": 7,
                      "column": 1,
                      "offset": 460
                    },
                    "end": {
                      "line": 7,
                      "column": 244,
                      "offset": 703
                    }
                  }
                }
              ],
              "position": {
                "start": {
                  "line": 7,
                  "column": 1,
                  "offset": 460
                },
                "end": {
                  "line": 7,
                  "column": 244,
                  "offset": 703
                }
              }
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "The version string is formatted as \"OPENQASM V.v;\", where \"V\" is the major version and \"v\" is the minor version number.",
                  "position": {
                    "start": {
                      "line": 9,
                      "column": 1,
                      "offset": 705
                    },
                    "end": {
                      "line": 9,
                      "column": 120,
                      "offset": 824
                    }
                  }
                }
              ],
              "position": {
                "start": {
                  "line": 9,
                  "column": 1,
                  "offset": 705
                },
                "end": {
                  "line": 9,
                  "column": 120,
                  "offset": 824
                }
              }
            },
            {
